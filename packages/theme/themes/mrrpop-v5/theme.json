{
  "id": "mrrpop-v5",
  "name": "MRR Pop v5 — Playful Editorial",
  "version": "5.0.0",
  "brand": {
    "name": "MRR Pop",
    "handle": "@getmrrpop",
    "tagline": "The business behind software.",
    "host": "Mr. Pop"
  },
  "colors": {
    "base": {
      "cream": {
        "value": "#F5F1E8",
        "role": "Page background (~65% of every frame)"
      },
      "white": {
        "value": "#FFFFFF",
        "role": "Cards, captions, bubbles"
      },
      "ink": {
        "value": "#29263D",
        "role": "Text, outlines, hard shadows"
      },
      "muted": {
        "value": "#7C7A92",
        "role": "Labels, secondary text"
      },
      "faint": {
        "value": "#9A98AE",
        "role": "Axis labels, meta"
      }
    },
    "scene": {
      "periwinkle": {
        "value": "#DCD9FA",
        "role": "Scene card — hook"
      },
      "sky": {
        "value": "#D8EAF8",
        "role": "Scene card — product"
      },
      "mint": {
        "value": "#D5EADF",
        "role": "Scene card — numbers"
      },
      "peach": {
        "value": "#F9D8CB",
        "role": "Scene card — story"
      },
      "butter": {
        "value": "#F4DB91",
        "role": "Scene card — end card; highlighter"
      }
    },
    "accent": {
      "violet": {
        "value": "#7467E8",
        "role": "Brand primary, accent word, CTA"
      },
      "coral": {
        "value": "#EF806F",
        "role": "Second accent, arrows, exclamations"
      },
      "violetSoft": {
        "value": "#BDB7F5",
        "role": "Chart bars (non-highlight)"
      }
    },
    "data": {
      "work": {
        "value": "#7467E8",
        "role": "Series 1"
      },
      "blue": {
        "value": "#5BA4E6",
        "role": "Series 2"
      },
      "green": {
        "value": "#4FB487",
        "role": "Series 3, positive delta"
      },
      "greenInk": {
        "value": "#2E8B60",
        "role": "Positive delta text"
      },
      "red": {
        "value": "#EF806F",
        "role": "Series 4, negative delta"
      }
    }
  },
  "roles": {
    "page": "base.cream",
    "surface": "base.white",
    "ink": "base.ink",
    "muted": "base.muted",
    "faint": "base.faint",
    "primary": "accent.violet",
    "onPrimary": "base.white",
    "secondary": "accent.coral",
    "highlight": "scene.butter",
    "hero": "scene.butter",
    "cardA": "scene.periwinkle",
    "cardB": "scene.mint",
    "cardC": "scene.peach",
    "positive": "data.green",
    "positiveInk": "data.greenInk"
  },
  "mix": {
    "neutral": 0.65,
    "soft": 0.25,
    "accent": 0.1
  },
  "evidence": {
    "payment-verified": {
      "label": "Payment-verified",
      "icon": "check",
      "bg": "#E3F3EA",
      "fg": "#2E8B60",
      "border": "#9ED3B6"
    },
    "company-announced": {
      "label": "Company-announced",
      "icon": "megaphone",
      "bg": "#E7EEFB",
      "fg": "#3B5C9A",
      "border": "#A9C1EA"
    },
    "founder-reported": {
      "label": "Founder-reported",
      "icon": "quote",
      "bg": "#FFF8E6",
      "fg": "#8A6400",
      "border": "#E8C96A"
    },
    "estimated": {
      "label": "Estimated",
      "icon": "approx",
      "bg": "#F1EFF6",
      "fg": "#5E5A78",
      "border": "#C9C5DA"
    },
    "sponsored": {
      "label": "Sponsored",
      "icon": "star",
      "bg": "#FDE7E2",
      "fg": "#B04A3A",
      "border": "#F2B3A7"
    },
    "demo": {
      "label": "DEMO data",
      "icon": "flask",
      "bg": "#FFFFFF",
      "fg": "#8A6400",
      "border": "#E8C96A"
    }
  },
  "series": {
    "revenue-pop": {
      "label": "Revenue Pop",
      "scene": "scene.periwinkle",
      "chip": "accent.violet",
      "icon": "cash"
    },
    "launch-pop": {
      "label": "Launch Pop",
      "scene": "scene.sky",
      "chip": "accent.violet",
      "icon": "rocket"
    },
    "deal-pop": {
      "label": "Deal Pop",
      "scene": "scene.peach",
      "chip": "accent.coral",
      "icon": "handshake"
    },
    "growth-story": {
      "label": "Growth Story",
      "scene": "scene.mint",
      "chip": "accent.violet",
      "icon": "growth"
    },
    "founder-brief": {
      "label": "Founder Brief",
      "scene": "scene.butter",
      "chip": "accent.coral",
      "icon": "bulb"
    },
    "sponsored-pop": {
      "label": "Sponsored Pop",
      "scene": "base.cream",
      "chip": "accent.coral",
      "icon": "star"
    }
  },
  "bubbles": [
    {
      "text": "WAIT!",
      "bg": "base.white",
      "fg": "accent.coral"
    },
    {
      "text": "BOOM!",
      "bg": "base.white",
      "fg": "accent.violet"
    },
    {
      "text": "WOW!",
      "bg": "base.white",
      "fg": "accent.coral"
    },
    {
      "text": "HOW?",
      "bg": "base.white",
      "fg": "accent.violet"
    }
  ],
  "fonts": {
    "sans": {
      "family": "Inter",
      "stack": "Inter, ui-sans-serif, system-ui, sans-serif",
      "files": [
        {
          "src": "fonts/Inter-Variable.ttf",
          "weight": "100 900",
          "style": "normal"
        },
        {
          "src": "fonts/Inter-Italic-Variable.ttf",
          "weight": "100 900",
          "style": "italic"
        }
      ],
      "features": "\"tnum\" 1",
      "license": "fonts/OFL-Inter.txt",
      "use": "Everything. Tight tracking on headlines, tabular numbers."
    },
    "accent": {
      "family": "Instrument Serif",
      "stack": "\"Instrument Serif\", ui-serif, Georgia, serif",
      "files": [
        {
          "src": "fonts/InstrumentSerif-Italic.ttf",
          "weight": "400",
          "style": "italic"
        },
        {
          "src": "fonts/InstrumentSerif-Regular.ttf",
          "weight": "400",
          "style": "normal"
        }
      ],
      "license": "fonts/OFL-InstrumentSerif.txt",
      "use": "ONE accent word per line, italic, in violet or coral."
    }
  },
  "type": {
    "number": {
      "size": 236,
      "weight": 900,
      "tracking": -12,
      "min": 160
    },
    "headline": {
      "size": 76,
      "weight": 900,
      "tracking": -3,
      "min": 64,
      "lineHeight": 1.02
    },
    "accentWord": {
      "scale": 1.16
    },
    "caption": {
      "size": 50,
      "weight": 800,
      "tracking": -1,
      "min": 52,
      "lineHeight": 1.15
    },
    "chip": {
      "size": 24,
      "weight": 800,
      "tracking": 1
    },
    "bubble": {
      "size": 52,
      "weight": 900,
      "tracking": -1
    }
  },
  "radius": {
    "panel": 60,
    "card": 36,
    "bubble": 30,
    "caption": 26,
    "chip": 999,
    "tile": 16
  },
  "shadow": {
    "panel": "0 30px 60px -30px rgba(41,38,61,.35), 0 2px 0 rgba(41,38,61,.06)",
    "card": "0 18px 40px -18px rgba(41,38,61,.35), 0 0 0 3px rgba(41,38,61,.06)",
    "caption": "0 14px 30px -14px rgba(41,38,61,.45)",
    "hard": "6px 6px 0 #29263D",
    "character": "0 18px 18px rgba(41,38,61,.22)"
  },
  "stroke": {
    "bubble": 5,
    "sticker": 6,
    "chart": 8
  },
  "texture": {
    "dotGrid": {
      "color": "rgba(41,38,61,.09)",
      "dot": 2,
      "gap": 36
    }
  },
  "motion": {
    "fps": 30,
    "easing": {
      "out": "cubic-bezier(0.33, 1, 0.68, 1)",
      "inOut": "cubic-bezier(0.65, 0, 0.35, 1)",
      "back": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "durations": {
      "popIn": 0.4,
      "bubbleIn": 0.35,
      "bubbleOut": 0.25,
      "sceneSlide": 0.55,
      "countUp": 0.9,
      "hop": 0.42
    },
    "sceneTransition": "paper-slide",
    "blinkEvery": 3.4
  },
  "layout": {
    "reel": {
      "width": 1080,
      "height": 1920,
      "safeTop": 250,
      "safeBottom": 400,
      "safeSide": 80,
      "panel": {
        "x": 36,
        "y": 236,
        "w": 1008,
        "h": 1290
      }
    },
    "carousel": {
      "width": 1080,
      "height": 1350,
      "maxSlides": 10
    },
    "post": [
      {
        "width": 1080,
        "height": 1350
      },
      {
        "width": 1080,
        "height": 1080
      }
    ],
    "story": {
      "width": 1080,
      "height": 1920
    }
  },
  "rules": [
    "No fluorescent colours, no full-black backgrounds, no heavy glows.",
    "~65% neutral / 25% soft scene colour / 10% accent.",
    "One Instrument Serif italic accent word per line.",
    "Evidence chip only when a number is on screen.",
    "Components read tokens from the theme — never hard-code colours."
  ],
  "logo": {
    "wordmark": "logo.svg",
    "mark": "logo-mark.svg"
  }
}
